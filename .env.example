# EVE Healthcare API - environment configuration
# Copy this file to .env and adjust values for your machine.

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database (SQLAlchemy URL) ---
# Local development (postgres running via docker-compose)
DATABASE_URL=postgresql+psycopg://eve:eve_password@localhost:5432/eve_healthcare
# Inside docker-compose the host is the service name:
# DATABASE_URL=postgresql+psycopg://eve:eve_password@db:5432/eve_healthcare

POSTGRES_USER=eve
POSTGRES_PASSWORD=eve_password
POSTGRES_DB=eve_healthcare
POSTGRES_PORT=5432

# --- Security ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Payments (simulated gateway) ---
# Deterministic simulation uses booking/payment id parity; this field is
# reserved for future integration with a real gateway.
PAYMENT_GATEWAY_URL=http://localhost:9999
